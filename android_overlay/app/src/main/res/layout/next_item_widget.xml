<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- ===== Primary: the next item ===== -->
    <TextView
        android:id="@+id/widget_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEXT UP"
        android:textColor="#FFB74D"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Title (left) + countdown (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No upcoming items"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text=""
            android:textColor="#FFB74D"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Open the app to add some"
        android:textColor="#E0E0E0"
        android:textSize="15sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Divider -->
    <View
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="#33FFFFFF" />

    <!-- ===== Secondary: the item after next ===== -->
    <TextView
        android:id="@+id/widget_following_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UP NEXT"
        android:textColor="#FFB74D"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_following_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_following_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#CFCFCF"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

</LinearLayout>
